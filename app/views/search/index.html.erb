<% content_for :title, @query.present? ? "検索: #{@query}" : "検索" %>
<h1 class="page-title"><%= icon_label "search", "検索", size: 26 %></h1>

<%= form_with url: search_path, method: :get, class: "search-form" do %>
  <input type="search" name="q" value="<%= @query %>" placeholder="キーワード（空白区切りで AND 検索）" autofocus>
  <button type="submit" class="button button-primary"><%= icon_label "search", "検索" %></button>
<% end %>

<% if @query.present? %>
  <p class="muted">「<%= @query %>」の検索結果: <%= @total %> 件</p>
  <% if can_edit? && !Page.find_by_title(@query) %>
    <p><%= link_to new_page_path(title: @query) do %><%= icon_label "file-plus", "ページ「#{@query}」を新規作成", size: 16 %><% end %></p>
  <% end %>
  <%= render "shared/page_list", pages: @pages, query: @query %>
  <%= render "shared/pagination", page_number: @page_number, has_next: @has_next %>
<% end %>
