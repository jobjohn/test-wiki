<% content_for :title, "初期設定" %>
<div class="setup">
  <h1 class="page-title"><%= icon_label "settings", "初期設定", size: 26 %></h1>
  <p class="muted">Wiki の使い始めに必要な設定です。ここで設定した内容は、あとから「Wiki の設定」でいつでも変更できます。</p>

  <%= form_with model: @setting, url: setup_path, method: :patch, class: "form-card" do |f| %>
    <%= render "shared/errors", messages: [*@setting.errors.full_messages, *@user_errors] %>

    <h2 class="form-section"><span class="step">1</span>どんな Wiki ですか？</h2>
    <div class="field">
      <%= f.label :wiki_name %>
      <%= f.text_field :wiki_name, required: true, maxlength: 50, placeholder: "例: 開発チーム Wiki" %>
    </div>
    <div class="field">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 3, placeholder: "例: 開発チームの手順書・設計資料・ノウハウをまとめる Wiki です。" %>
      <p class="hint">ホーム画面の上部に表示されます（Markdown 可）。</p>
    </div>

    <h2 class="form-section"><span class="step">2</span>カラーテーマ</h2>
    <%= render "settings/theme_fields", setting: @setting, legend: false %>

    <% if current_user.must_change_password? %>
      <h2 class="form-section"><span class="step">3</span>管理者パスワードの変更</h2>
      <p class="hint">初期ユーザー <code><%= current_user.username %></code> のパスワードを変更してください（8 文字以上）。</p>
      <div class="field-row">
        <div class="field">
          <label for="password">新しいパスワード</label>
          <input type="password" name="password" id="password" autocomplete="new-password" minlength="8" required>
        </div>
        <div class="field">
          <label for="password_confirmation">新しいパスワード（確認）</label>
          <input type="password" name="password_confirmation" id="password_confirmation" autocomplete="new-password" minlength="8" required>
        </div>
      </div>
    <% end %>

    <div class="form-actions">
      <%= f.button class: "button button-primary" do %><%= icon_label "check", "設定を完了して始める" %><% end %>
    </div>
  <% end %>
</div>
