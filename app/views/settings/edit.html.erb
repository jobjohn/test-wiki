<% content_for :title, "Wiki の設定" %>
<h1 class="page-title"><%= icon_label "settings", "Wiki の設定", size: 26 %></h1>

<%= form_with model: @setting, url: settings_path, method: :patch, class: "form-card" do |f| %>
  <%= render "shared/errors", record: @setting %>

  <h2 class="form-section"><%= icon_label "book-open", "基本情報", size: 18 %></h2>
  <div class="field">
    <%= f.label :wiki_name %>
    <%= f.text_field :wiki_name, required: true, maxlength: 50 %>
  </div>
  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 3 %>
    <p class="hint">ホーム画面の上部に表示されます（Markdown 可）。</p>
  </div>

  <h2 class="form-section"><%= icon_label "palette", "見た目", size: 18 %></h2>
  <%= render "settings/theme_fields", setting: @setting %>
  <fieldset class="field">
    <legend>表示モード</legend>
    <div class="segmented">
      <% { "system" => "monitor", "light" => "sun", "dark" => "moon" }.each do |mode, icon_name| %>
        <label>
          <%= f.radio_button :color_mode, mode, data: { color_mode: true } %>
          <span><%= icon_label icon_name, Setting::COLOR_MODES[mode], size: 16 %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <h2 class="form-section"><%= icon_label "shield-check", "アクセスとセキュリティ", size: 18 %></h2>
  <label class="checkbox">
    <%= f.check_box :public_read %>
    <span><strong><%= Setting.human_attribute_name(:public_read) %></strong><br><span class="hint">オンにすると、ログインしていない人もページを閲覧できます（編集にはログインが必要）。</span></span>
  </label>
  <label class="checkbox">
    <%= f.check_box :require_mfa %>
    <span><strong><%= Setting.human_attribute_name(:require_mfa) %></strong><br><span class="hint">オンにすると、二段階認証を設定していないユーザーはログイン後に設定画面へ案内されます。</span></span>
  </label>

  <div class="form-actions">
    <%= f.button class: "button button-primary" do %><%= icon_label "save", "設定を保存" %><% end %>
  </div>
<% end %>
