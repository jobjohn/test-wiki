<% content_for :title, "ホーム" %>

<section class="hero">
  <div class="hero-mark"><%= icon "book-open", size: 28 %></div>
  <div>
    <h1><%= wiki_name %></h1>
    <% if wiki_setting.description.present? %>
      <div class="hero-description"><%= markdown(wiki_setting.description) %></div>
    <% elsif admin? %>
      <p class="muted">この Wiki の説明は<%= link_to "設定", edit_settings_path %>から追加できます。</p>
    <% end %>
  </div>
</section>

<% if @home_page %>
  <article class="page card">
    <header class="card-header">
      <h2><%= icon_label "file-text", @home_page.title %></h2>
      <% if can_edit? %>
        <%= link_to edit_page_path(@home_page), class: "button button-small" do %><%= icon_label "pencil", "編集", size: 14 %><% end %>
      <% end %>
    </header>
    <%= markdown(@home_page.body) %>
  </article>
<% end %>

<div class="dashboard">
  <section class="card">
    <header class="card-header"><h2><%= icon_label "clock", "最近更新されたページ" %></h2></header>
    <% if @recent_pages.any? %>
      <%= render "shared/page_list", pages: @recent_pages %>
      <p><%= link_to recent_changes_path, class: "link-more" do %>すべての更新履歴<%= icon "arrow-right", size: 14 %><% end %></p>
    <% else %>
      <p class="muted">まだページがありません。<% if can_edit? %><%= link_to "最初のページを作成", new_page_path %>しましょう。<% end %></p>
    <% end %>
  </section>

  <div class="dashboard-side">
    <section class="card">
      <header class="card-header"><h2><%= icon_label "folder", "フォルダ" %></h2></header>
      <% if @root_folders.any? %>
        <ul class="folder-list">
          <% @root_folders.each do |folder| %>
            <li><%= link_to folder do %><%= icon_label "folder", folder.name, size: 16 %><% end %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted small">フォルダはまだありません。</p>
      <% end %>
      <% if can_edit? %>
        <%= link_to new_folder_path, class: "button button-small" do %><%= icon_label "folder-plus", "フォルダを作成", size: 14 %><% end %>
      <% end %>
    </section>

    <section class="card">
      <header class="card-header"><h2><%= icon_label "tags", "タグ" %></h2></header>
      <% if @tags.any? %>
        <div class="tag-cloud">
          <% @tags.each do |tag| %>
            <%= link_to tag_path(tag), class: "tag" do %><%= icon "tag", size: 12 %><%= tag.name %> <span class="count"><%= tag.pages_count %></span><% end %>
          <% end %>
        </div>
      <% else %>
        <p class="muted small">タグはまだありません。</p>
      <% end %>
      <p class="muted small">全 <%= @pages_count %> ページ</p>
    </section>
  </div>
</div>
