<% content_for :title, "履歴: #{@page.title}" %>
<nav class="breadcrumbs"><%= link_to icon_label("file-text", @page.title, size: 14), @page %></nav>
<h1 class="page-title"><%= icon_label "history", "変更履歴", size: 26 %></h1>

<table class="table">
  <thead>
    <tr><th>版</th><th>日時</th><th>編集者</th><th>タイトル</th><th>要約</th><th></th></tr>
  </thead>
  <tbody>
    <% @revisions.each do |revision| %>
      <tr>
        <td><%= link_to "第#{revision.number}版", page_revision_path(@page, revision) %></td>
        <td class="nowrap"><%= l revision.created_at, format: :wiki %></td>
        <td><%= revision.user&.name || "—" %></td>
        <td><%= revision.title %></td>
        <td><%= revision.summary %></td>
        <td class="nowrap">
          <% if revision == @revisions.first %>
            <span class="badge">現在</span>
          <% else %>
            <% if can_edit? %>
              <%= button_to restore_page_revision_path(@page, revision), class: "button button-small",
                    form: { data: { confirm: "第#{revision.number}版の内容に戻しますか？（新しい版として保存されます）" } } do %><%= icon_label "rotate-ccw", "この版に戻す", size: 14 %><% end %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
