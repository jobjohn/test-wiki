<% content_for :title, "最近の更新" %>
<h1>最近の更新</h1>

<% if @revisions.any? %>
  <table class="table">
    <thead><tr><th>日時</th><th>ページ</th><th>版</th><th>要約</th></tr></thead>
    <tbody>
      <% @revisions.each do |revision| %>
        <tr>
          <td class="nowrap"><%= l revision.created_at, format: :wiki %></td>
          <td><%= link_to revision.page.title, revision.page %></td>
          <td class="nowrap"><%= link_to "第#{revision.number}版", page_revision_path(revision.page, revision) %></td>
          <td><%= revision.summary %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", page_number: @page_number, has_next: @has_next %>
<% else %>
  <p class="muted">まだ更新はありません。</p>
<% end %>
