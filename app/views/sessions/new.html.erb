<% content_for :title, "ログイン" %>
<%= form_with url: login_path, class: "auth-form" do %>
  <div class="field">
    <label for="username">ユーザー名</label>
    <div class="input-icon">
      <%= icon "user", size: 16 %>
      <input type="text" name="username" id="username" value="<%= params[:username] %>" autocomplete="username" autocapitalize="none" required autofocus>
    </div>
  </div>
  <div class="field">
    <label for="password">パスワード</label>
    <div class="input-icon">
      <%= icon "lock", size: 16 %>
      <input type="password" name="password" id="password" autocomplete="current-password" required>
    </div>
  </div>
  <button type="submit" class="button button-primary button-block"><%= icon_label "log-in", "ログイン" %></button>
<% end %>

<% unless wiki_setting.setup_completed? %>
  <div class="notice-box">
    <%= icon "info", size: 18 %>
    <div>
      <strong>初回セットアップ</strong><br>
      ユーザー名 <code><%= User::DEFAULT_ADMIN_USERNAME %></code>
      <% if ENV["WIKI_ADMIN_PASSWORD"].present? %>
        と環境変数 <code>WIKI_ADMIN_PASSWORD</code> のパスワードでログインしてください。
      <% else %>
        / パスワード <code><%= User::DEFAULT_ADMIN_USERNAME %></code> でログインしてください。
      <% end %>
      ログイン後に初期設定とパスワード変更を行います。
    </div>
  </div>
<% end %>

<% if wiki_setting.public_read? %>
  <p class="auth-footer"><%= link_to root_path do %><%= icon_label "arrow-left", "ログインせずに閲覧する", size: 14 %><% end %></p>
<% end %>
