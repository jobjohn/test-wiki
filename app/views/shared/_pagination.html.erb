<% if page_number > 1 || has_next %>
  <nav class="pagination">
    <% if page_number > 1 %>
      <%= link_to url_for(request.query_parameters.merge(page: page_number - 1)), class: "button" do %><%= icon_label "arrow-left", "前へ" %><% end %>
    <% end %>
    <span class="muted"><%= page_number %> ページ目</span>
    <% if has_next %>
      <%= link_to url_for(request.query_parameters.merge(page: page_number + 1)), class: "button" do %><span>次へ</span><%= icon "arrow-right" %><% end %>
    <% end %>
  </nav>
<% end %>
