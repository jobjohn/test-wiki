<%= form_with model: folder, class: "form-card" do |f| %>
  <%= render "shared/errors", record: folder %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, maxlength: 100, autofocus: true, placeholder: "例: 開発ドキュメント" %>
  </div>
  <div class="field-row">
    <div class="field">
      <%= f.label :parent_id %>
      <%= f.select :parent_id, options_for_select(folder.parent_candidates, folder.parent_id), { include_blank: "（トップ）" } %>
      <p class="hint">フォルダの中にフォルダを入れて階層化できます。</p>
    </div>
    <div class="field field-narrow">
      <%= f.label :position %>
      <%= f.number_field :position, step: 1 %>
    </div>
  </div>
  <div class="form-actions">
    <%= f.button class: "button button-primary" do %><%= icon_label "save", "保存" %><% end %>
    <%= link_to "キャンセル", folder.persisted? ? folder_path(folder) : (folder.parent || root_path), class: "button" %>
  </div>
<% end %>
