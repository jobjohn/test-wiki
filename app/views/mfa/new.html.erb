<% content_for :title, "二段階認証の設定" %>
<h1 class="page-title"><%= icon_label "shield-check", "二段階認証の設定", size: 26 %></h1>

<div class="form-card mfa-setup">
  <ol class="steps">
    <li>
      <strong>認証アプリで QR コードを読み取ります</strong>
      <p class="hint">Google Authenticator、Microsoft Authenticator、1Password などが使えます。</p>
      <div class="qr"><%= @qr_svg %></div>
      <details>
        <summary>QR コードを読み取れない場合</summary>
        <p class="hint">アプリに次のキーを手入力してください。</p>
        <code class="secret copyable" data-copy title="クリックでコピー"><%= @secret.scan(/.{1,4}/).join(" ") %></code>
      </details>
    </li>
    <li>
      <strong>アプリに表示された 6 桁のパスコードを入力します</strong>
      <%= form_with url: mfa_path, class: "input-with-button" do %>
        <input type="text" name="code" class="code-input" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" required autofocus placeholder="123456" aria-label="パスコード">
        <button type="submit" class="button button-primary"><%= icon_label "check", "有効にする" %></button>
      <% end %>
    </li>
  </ol>
</div>
<% unless wiki_setting.require_mfa? %>
  <p><%= link_to account_path do %><%= icon_label "arrow-left", "アカウントに戻る", size: 14 %><% end %></p>
<% end %>
