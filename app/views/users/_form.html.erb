<%= form_with model: user, class: "form-card" do |f| %>
  <%= render "shared/errors", record: user %>
  <div class="field-row">
    <div class="field">
      <%= f.label :username %>
      <%= f.text_field :username, required: true, autocapitalize: "none", placeholder: "例: yamada" %>
    </div>
    <div class="field">
      <%= f.label :display_name %>
      <%= f.text_field :display_name, placeholder: "例: 山田 太郎" %>
    </div>
  </div>
  <div class="field">
    <%= f.label :role %>
    <%= f.select :role, User::ROLES.invert %>
  </div>
  <div class="field-row">
    <div class="field">
      <%= f.label :password, user.persisted? ? "新しいパスワード（変更する場合のみ）" : "初期パスワード" %>
      <%= f.password_field :password, autocomplete: "new-password", minlength: 8, required: user.new_record? %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", minlength: 8, required: user.new_record? %>
    </div>
  </div>
  <label class="checkbox">
    <%= f.check_box :must_change_password %>
    <span><%= User.human_attribute_name(:must_change_password) %></span>
  </label>
  <div class="form-actions">
    <%= f.button class: "button button-primary" do %><%= icon_label "save", "保存" %><% end %>
    <%= link_to "キャンセル", users_path, class: "button" %>
  </div>
<% end %>
