<% content_for :title, "ユーザー管理" %>
<header class="page-header page-header-flex">
  <h1 class="page-title"><%= icon_label "users", "ユーザー管理", size: 26 %></h1>
  <%= link_to new_user_path, class: "button button-primary" do %><%= icon_label "user-plus", "ユーザーを追加" %><% end %>
</header>

<table class="table">
  <thead><tr><th>ユーザー</th><th>権限</th><th>二段階認証</th><th>最終ログイン</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td>
          <span class="user-cell">
            <span class="avatar avatar-small"><%= user.name.first.upcase %></span>
            <span><strong><%= user.name %></strong><br><span class="muted small">@<%= user.username %></span></span>
          </span>
        </td>
        <td><span class="badge badge-<%= user.role %>"><%= user.role_name %></span></td>
        <td><% if user.mfa_enabled? %><span class="status-on"><%= icon_label "shield-check", "有効", size: 14 %></span><% else %><span class="muted">未設定</span><% end %></td>
        <td class="nowrap"><%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :wiki) : "—" %></td>
        <td class="nowrap">
          <%= link_to edit_user_path(user), class: "icon-button", title: "編集" do %><%= icon "pencil", size: 16 %><% end %>
          <% unless user == current_user %>
            <%= button_to user_path(user), method: :delete, class: "icon-button icon-button-danger", title: "削除",
                  form: { data: { confirm: "ユーザー「#{user.username}」を削除しますか？" } } do %><%= icon "trash-2", size: 16 %><% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="role-help card">
  <h2><%= icon_label "info", "権限について", size: 16 %></h2>
  <ul>
    <li><strong>管理者</strong>: すべての操作と Wiki の設定・ユーザー管理</li>
    <li><strong>編集者</strong>: ページ・フォルダの作成と編集、ファイルのアップロード</li>
    <li><strong>閲覧者</strong>: 閲覧のみ</li>
  </ul>
</div>
