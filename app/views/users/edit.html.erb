<% content_for :title, "ユーザーの編集" %>
<h1 class="page-title"><%= icon_label "user", "ユーザーの編集", size: 26 %></h1>
<%= render "form", user: @user %>

<% if @user.mfa_enabled? %>
  <section class="card danger-zone">
    <h2><%= icon_label "shield-check", "二段階認証", size: 18 %></h2>
    <p>このユーザーは二段階認証を有効にしています。スマートフォンの紛失などでログインできなくなった場合はリセットしてください。</p>
    <%= button_to reset_mfa_user_path(@user), class: "button button-danger",
          form: { data: { confirm: "二段階認証をリセットしますか？" } } do %><%= icon_label "rotate-ccw", "二段階認証をリセット" %><% end %>
  </section>
<% end %>
