<% content_for :title, "アカウント" %>
<h1 class="page-title"><%= icon_label "user", "アカウント", size: 26 %></h1>

<section class="card">
  <h2><%= icon_label "user", "プロフィール", size: 18 %></h2>
  <%= form_with model: @user, url: account_path, method: :patch, class: "inline-form" do |f| %>
    <%= render "shared/errors", record: @user %>
    <dl class="meta-list">
      <dt>ユーザー名</dt><dd><code><%= @user.username %></code></dd>
      <dt>権限</dt><dd><span class="badge badge-<%= @user.role %>"><%= @user.role_name %></span></dd>
    </dl>
    <div class="field">
      <%= f.label :display_name %>
      <div class="input-with-button">
        <%= f.text_field :display_name, maxlength: 50 %>
        <%= f.button class: "button" do %><%= icon_label "save", "保存", size: 16 %><% end %>
      </div>
    </div>
  <% end %>
</section>

<section class="card">
  <h2><%= icon_label "key-round", "パスワード", size: 18 %></h2>
  <%= link_to edit_password_path, class: "button" do %><%= icon_label "key-round", "パスワードを変更" %><% end %>
</section>

<section class="card">
  <h2><%= icon_label "shield-check", "二段階認証（MFA）", size: 18 %></h2>
  <% if @user.mfa_enabled? %>
    <p class="status-on"><%= icon_label "shield-check", "有効（#{l @user.otp_enabled_at, format: :wiki} から）", size: 16 %></p>
    <p class="muted small">残りのバックアップコード: <%= @user.remaining_backup_codes %> 個</p>
    <div class="mfa-actions">
      <%= form_with url: backup_codes_mfa_path, class: "input-with-button" do %>
        <input type="password" name="password" placeholder="パスワード" autocomplete="current-password" required aria-label="パスワード">
        <button type="submit" class="button"><%= icon_label "rotate-ccw", "バックアップコードを再発行", size: 16 %></button>
      <% end %>
      <% unless wiki_setting.require_mfa? %>
        <%= form_with url: mfa_path, method: :delete, class: "input-with-button", data: { confirm: "二段階認証を無効にしますか？" } do %>
          <input type="password" name="password" placeholder="パスワード" autocomplete="current-password" required aria-label="パスワード">
          <button type="submit" class="button button-danger"><%= icon_label "x", "無効にする", size: 16 %></button>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p>ログイン時にパスワードに加えて、スマートフォンの認証アプリ（Google Authenticator、Microsoft Authenticator など）に表示されるパスコードを入力するようにできます。</p>
    <%= link_to new_mfa_path, class: "button button-primary" do %><%= icon_label "smartphone", "二段階認証を設定する" %><% end %>
  <% end %>
</section>
