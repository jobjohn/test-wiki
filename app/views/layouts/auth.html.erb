<!DOCTYPE html>
<html lang="ja" data-theme="<%= wiki_setting.color_mode %>">
  <head>
    <title><%= [content_for(:title), wiki_name].compact.join(" - ") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="auth-body">
    <main class="auth-card">
      <div class="auth-brand">
        <span class="brand-mark brand-mark-large"><%= icon "book-open", size: 28 %></span>
        <h1><%= wiki_name %></h1>
      </div>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
