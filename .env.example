# cp .env.example .env でコピーし、値を書き換えてから起動してください
WIKI_PORT=8473
# 初期管理者のメールアドレスとパスワード（必須。パスワードは 8 文字以上）
# 初回起動時（データベースが空のとき）に、この内容で管理者を作成します
WIKI_ADMIN_EMAIL=you@example.com
WIKI_ADMIN_PASSWORD=change-me-please
TZ=Asia/Tokyo
# FORCE_SSL=true
# ホーム画面に表示するページのタイトル（既定: ホーム）
# WIKI_HOME_PAGE=ホーム
# 二段階認証の情報を暗号化する鍵（未設定なら初回に自動生成してデータ領域に保存）
# SECRET_KEY_BASE=
